# ==============================================================================
# Achintya Matrimony CRM - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env.local' and supply your actual configuration values.
# IMPORTANT: Never commit '.env.local' or paste real production secrets in git.
# ==============================================================================

# Supabase Public Configuration (Safe for client-side use)
# Obtain these from your Supabase Dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Private Configuration (SERVER-SIDE ONLY - NEVER expose to browser)
# Keep empty unless specific server-side administrative bypass operations are approved.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Application Base URL (for generated share links & redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local Development Administrator Account (Used when Supabase is not connected)
# Configure these in your private .env.local file for local development testing only.
# Do NOT deploy these to production.
DEV_ADMIN_EMAIL=admin@achintyamatrimony.test
DEV_ADMIN_PASSWORD=your-local-development-password-here
